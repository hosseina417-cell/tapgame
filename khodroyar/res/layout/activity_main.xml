<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primary"
            android:paddingStart="18dp"
            android:paddingEnd="6dp"
            android:paddingTop="14dp"
            android:paddingBottom="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⋮"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_header_btn"
                    android:contentDescription="@string/menu_more"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Stats strip -->
        <LinearLayout
            android:id="@+id/boxStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="9dp"
            android:gravity="center">

            <TextView
                android:id="@+id/statTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/textSec"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="@color/divider"/>

            <TextView
                android:id="@+id/statOpen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:textColor="@color/stChecking"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="@color/divider"/>

            <TextView
                android:id="@+id/statFixed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:textColor="@color/stFixed"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Search -->
        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="10dp"
            android:hint="@string/search_hint"
            style="@style/TextInput"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:drawablePadding="8dp"/>

        <!-- Car folders (filter chips) -->
        <HorizontalScrollView
            android:id="@+id/scrollCars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/rowCars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"/>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/listFaults"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingBottom="96dp"
                android:clipToPadding="false"
                android:scrollbars="none"/>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/boxEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗"
                    android:textSize="52sp"/>

                <TextView
                    android:id="@+id/txtEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_title"
                    android:textColor="@color/textMain"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/txtEmptyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_hint"
                    android:textColor="@color/textSec"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- FAB -->
    <TextView
        android:id="@+id/fabAdd"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:background="@drawable/bg_fab"
        android:elevation="6dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:contentDescription="@string/new_fault"/>
</FrameLayout>
