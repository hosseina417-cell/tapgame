<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/windowBg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary"
        android:padding="14dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:paddingStart="6dp"
            android:paddingEnd="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_header_btn"/>

        <TextView
            android:id="@+id/txtEditTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- Fault info card -->
            <LinearLayout style="@style/CardBox" android:orientation="vertical">
                <TextView style="@style/SectionTitle" android:text="🔧 مشخصات خطا"/>

                <TextView style="@style/FieldLabel" android:text="@string/fault_title_label"/>
                <EditText
                    android:id="@+id/edtTitle"
                    style="@style/TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:inputType="textCapSentences"/>

                <TextView style="@style/FieldLabel" android:text="@string/car_name_label"/>
                <EditText
                    android:id="@+id/edtCar"
                    style="@style/TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="textCapSentences"
                    android:hint="مثلاً: پژو ۲۰۶ مدل ۹۸"/>

                <TextView style="@style/FieldLabel" android:text="@string/obd_code_label"/>
                <EditText
                    android:id="@+id/edtObd"
                    style="@style/TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="textCapCharacters"
                    android:hint="مثلاً: P0300"/>
            </LinearLayout>

            <!-- Severity & status card -->
            <LinearLayout style="@style/CardBox" android:orientation="vertical">
                <TextView style="@style/SectionTitle" android:text="⚠️ ارزیابی"/>
                <TextView style="@style/FieldLabel" android:text="@string/severity_label"/>
                <LinearLayout
                    android:id="@+id/rowSeverity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

                <TextView style="@style/FieldLabel" android:text="@string/status_label"/>
                <LinearLayout
                    android:id="@+id/rowStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </LinearLayout>

            <!-- Description card -->
            <LinearLayout style="@style/CardBox" android:orientation="vertical">
                <TextView style="@style/SectionTitle" android:text="📝 شرح مشکل"/>

                <TextView style="@style/FieldLabel" android:text="@string/symptoms_label"/>
                <EditText
                    android:id="@+id/edtSymptoms"
                    style="@style/TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:inputType="textMultiLine"
                    android:hint="@string/symptoms_hint"/>

                <TextView style="@style/FieldLabel" android:text="@string/description_label"/>
                <EditText
                    android:id="@+id/edtDesc"
                    style="@style/TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:inputType="textMultiLine"/>
            </LinearLayout>

            <!-- Repair card -->
            <LinearLayout style="@style/CardBox" android:orientation="vertical">
                <TextView style="@style/SectionTitle" android:text="🛠️ تعمیر"/>

                <TextView style="@style/FieldLabel" android:text="@string/repair_label"/>
                <EditText
                    android:id="@+id/edtRepair"
                    style="@style/TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:inputType="textMultiLine"
                    android:hint="@string/repair_hint"/>

                <TextView style="@style/FieldLabel" android:text="@string/tools_label"/>
                <EditText
                    android:id="@+id/edtTools"
                    style="@style/TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:inputType="textMultiLine"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/FieldLabel"
                    android:text="@string/tool_quick_title"/>
                <LinearLayout
                    android:id="@+id/rowToolChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

                <TextView style="@style/FieldLabel" android:text="@string/parts_label"/>
                <EditText
                    android:id="@+id/edtParts"
                    style="@style/TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:inputType="textMultiLine"/>
            </LinearLayout>

            <!-- Cost card -->
            <LinearLayout style="@style/CardBox" android:orientation="vertical">
                <TextView style="@style/SectionTitle" android:text="💰 هزینه"/>
                <TextView style="@style/FieldLabel" android:text="@string/cost_label"/>
                <EditText
                    android:id="@+id/edtCost"
                    style="@style/TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="number"
                    android:hint="0"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Save bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/cardBg"
        android:elevation="8dp"
        android:padding="12dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Chip"
            android:gravity="center"
            android:text="@string/cancel"
            android:layout_marginStart="4dp"/>

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            style="@style/BtnPrimary"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/save"/>
    </LinearLayout>
</LinearLayout>
