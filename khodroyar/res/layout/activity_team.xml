<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/windowBg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary"
        android:padding="14dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:paddingStart="6dp"
            android:paddingEnd="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_header_btn"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/team_title"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardBox"
                android:background="@drawable/bg_card"
                android:text="@string/team_note"
                android:textColor="@color/textSec"
                android:textSize="12sp"/>

            <!-- who am I -->
            <LinearLayout style="@style/CardBox" android:orientation="vertical">
                <TextView style="@style/SectionTitle" android:text="👤 مشخصات من"/>
                <TextView style="@style/FieldLabel" android:text="@string/team_device_name"/>
                <EditText
                    android:id="@+id/edtDeviceName"
                    style="@style/TextInput"
                    android:maxLines="1"
                    android:inputType="textCapSentences"
                    android:hint="@string/team_device_hint"/>
            </LinearLayout>

            <!-- manager mode -->
            <LinearLayout style="@style/CardBox" android:orientation="vertical">
                <TextView style="@style/SectionTitle" android:text="👨‍💼 حالت مدیر"/>
                <TextView
                    android:id="@+id/btnServerToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/BtnPrimary"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/team_start_server"/>

                <TextView
                    android:id="@+id/txtServerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/textSec"
                    android:textSize="12sp"
                    android:text="@string/team_server_stopped"/>

                <TextView
                    android:id="@+id/txtServerIps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/FieldLabel"
                    android:text="@string/team_log_title"/>

                <TextView
                    android:id="@+id/txtLogEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/team_log_empty"
                    android:textColor="@color/textSec"
                    android:textSize="12sp"/>

                <ListView
                    android:id="@+id/listLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@color/divider"
                    android:dividerHeight="1dp"
                    android:scrollbars="none"/>
            </LinearLayout>

            <!-- employee mode -->
            <LinearLayout style="@style/CardBox" android:orientation="vertical">
                <TextView style="@style/SectionTitle" android:text="🧑‍🔧 حالت کارمند"/>
                <TextView style="@style/FieldLabel" android:text="@string/team_ip_label"/>
                <EditText
                    android:id="@+id/edtManagerIp"
                    style="@style/TextInput"
                    android:maxLines="1"
                    android:inputType="text"
                    android:hint="@string/team_ip_hint"/>

                <TextView
                    android:id="@+id/btnSyncNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/BtnPrimary"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/team_sync_now"/>

                <TextView
                    android:id="@+id/txtSyncResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/textSec"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
